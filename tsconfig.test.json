{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "outDir": ".test-build",
    "rootDir": "src",
    "declaration": false,
    "sourceMap": false
  },
  "include": ["src/lib/types.ts", "src/lib/taxonomy.ts", "src/lib/match.ts", "src/lib/advice.ts"]
}
